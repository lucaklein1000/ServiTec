<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- HEADER SUPERIOR -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:padding="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <Button
            android:id="@+id/btnVolver"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#1E3A8A"
            android:text="← Enrere"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnVolver"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvTituloMesa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Taula"
                android:textColor="#1E293B"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubtitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Comanda actual"
                android:textColor="#64748B"
                android:textSize="13sp" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- CONTENIDO PRINCIPAL (3 COLUMNAS) -->
    <LinearLayout
        android:id="@+id/layoutColumnas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader">

        <!-- COLUMNA 1 (IZQUIERDA): Categorías -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCategorias"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.8"
            android:padding="8dp" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#CBD5E1" />

        <!-- COLUMNA 2 (CENTRO): Ticket Único con Scroll + Total + Enviar -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3.8"
            android:background="#FFFFFF"
            android:elevation="1dp"
            android:orientation="vertical">

            <!-- Lista Única para la Comanda -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPedido"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="6dp"
                tools:listitem="@layout/item_producto_ticket" />

            <!-- Bloque Inferior: Total y Enviar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#F8FAFC"
                android:orientation="vertical"
                android:padding="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginBottom="6dp"
                    android:background="#E2E8F0"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Total"
                        android:textColor="#1E293B"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTotalPrecio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.00 €"
                        android:textColor="#1E293B"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnEnviar"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:backgroundTint="#1E3A8A"
                    android:text="✓ Enviar a cuina"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#CBD5E1" />

        <!-- COLUMNA 3 (DERECHA): Carta de Productos + Teclado Numérico + Botonera -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="4.4"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- Cuadrícula de Productos -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSeleccionProductos"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingBottom="8dp" />

            <!-- Panel Teclado Numérico y Acciones -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <!-- Indicador de Cantidad -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="8dp"
                        android:paddingBottom="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Quantitat:"
                            android:textColor="#64748B"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvQuantitatTeclejada"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="1x"
                            android:textColor="#1E3A8A"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Teclado Numérico Grid (Ajustado a 38dp) -->
                        <GridLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2.8"
                            android:columnCount="3"
                            android:rowCount="4">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnNum7"
                                android:layout_width="0dp"
                                android:layout_height="38dp"
                                android:layout_columnWeight="1"
                                android:layout_margin="2dp"
                                android:text="7"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                app:backgroundTint="#1E3A8A"
                                app:cornerRadius="8dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnNum8"
                                android:layout_width="0dp"
                                android:layout_height="38dp"
                                android:layout_columnWeight="1"
                                android:layout_margin="2dp"
                                android:text="8"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                app:backgroundTint="#1E3A8A"
                                app:cornerRadius="8dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnNum9"
                                android:layout_width="0dp"
                                android:layout_height="38dp"
                                android:layout_columnWeight="1"
                                android:layout_margin="2dp"
                                android:text="9"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                app:backgroundTint="#1E3A8A"
                                app:cornerRadius="8dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnNum4"
                                android:layout_width="0dp"
                                android:layout_height="38dp"
                                android:layout_columnWeight="1"
                                android:layout_margin="2dp"
                                android:text="4"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                app:backgroundTint="#1E3A8A"
                                app:cornerRadius="8dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnNum5"
                                android:layout_width="0dp"
                                android:layout_height="38dp"
                                android:layout_columnWeight="1"
                                android:layout_margin="2dp"
                                android:text="5"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                app:backgroundTint="#1E3A8A"
                                app:cornerRadius="8dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnNum6"
                                android:layout_width="0dp"
                                android:layout_height="38dp"
                                android:layout_columnWeight="1"
                                android:layout_margin="2dp"
                                android:text="6"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                app:backgroundTint="#1E3A8A"
                                app:cornerRadius="8dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnNum1"
                                android:layout_width="0dp"
                                android:layout_height="38dp"
                                android:layout_columnWeight="1"
                                android:layout_margin="2dp"
                                android:text="1"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                app:backgroundTint="#1E3A8A"
                                app:cornerRadius="8dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnNum2"
                                android:layout_width="0dp"
                                android:layout_height="38dp"
                                android:layout_columnWeight="1"
                                android:layout_margin="2dp"
                                android:text="2"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                app:backgroundTint="#1E3A8A"
                                app:cornerRadius="8dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnNum3"
                                android:layout_width="0dp"
                                android:layout_height="38dp"
                                android:layout_columnWeight="1"
                                android:layout_margin="2dp"
                                android:text="3"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                app:backgroundTint="#1E3A8A"
                                app:cornerRadius="8dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnNumC"
                                android:layout_width="0dp"
                                android:layout_height="38dp"
                                android:layout_columnWeight="1"
                                android:layout_margin="2dp"
                                android:text="C"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                app:backgroundTint="#3B82F6"
                                app:cornerRadius="8dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnNum0"
                                android:layout_width="0dp"
                                android:layout_height="38dp"
                                android:layout_columnWeight="1"
                                android:layout_margin="2dp"
                                android:text="0"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                app:backgroundTint="#1E3A8A"
                                app:cornerRadius="8dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnNumBorrarUn"
                                android:layout_width="0dp"
                                android:layout_height="38dp"
                                android:layout_columnWeight="1"
                                android:layout_margin="2dp"
                                android:text="⌫"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                app:backgroundTint="#64748B"
                                app:cornerRadius="8dp" />
                        </GridLayout>

                        <!-- Botonera Lateral Reorganizada -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.6"
                            android:orientation="vertical"
                            android:paddingStart="4dp">

                            <!-- Fila 1: + y Borrar -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnSumarProducte"
                                    android:layout_width="0dp"
                                    android:layout_height="38dp"
                                    android:layout_margin="2dp"
                                    android:layout_weight="1"
                                    android:insetLeft="0dp"
                                    android:insetTop="0dp"
                                    android:insetRight="0dp"
                                    android:insetBottom="0dp"
                                    android:minWidth="0dp"
                                    android:minHeight="0dp"
                                    android:padding="0dp"
                                    android:text="+"
                                    android:textColor="#FFFFFF"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    app:backgroundTint="#3B82F6"
                                    app:cornerRadius="8dp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnBorrarProductos"
                                    android:layout_width="0dp"
                                    android:layout_height="38dp"
                                    android:layout_margin="2dp"
                                    android:layout_weight="1"
                                    android:insetLeft="0dp"
                                    android:insetTop="0dp"
                                    android:insetRight="0dp"
                                    android:insetBottom="0dp"
                                    android:minWidth="0dp"
                                    android:minHeight="0dp"
                                    android:padding="0dp"
                                    app:backgroundTint="#EF4444"
                                    app:cornerRadius="8dp"
                                    app:icon="@android:drawable/ic_menu_delete"
                                    app:iconGravity="textStart"
                                    app:iconPadding="0dp"
                                    app:iconSize="18dp"
                                    app:iconTint="#FFFFFF" />
                            </LinearLayout>

                            <!-- Fila 2: Cambiar Orden 1º/2º y Segons -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnCambiarOrden"
                                    android:layout_width="0dp"
                                    android:layout_height="38dp"
                                    android:layout_margin="2dp"
                                    android:layout_weight="1"
                                    android:insetLeft="0dp"
                                    android:insetTop="0dp"
                                    android:insetRight="0dp"
                                    android:insetBottom="0dp"
                                    android:minWidth="0dp"
                                    android:minHeight="0dp"
                                    android:padding="0dp"
                                    android:text="1º ⇄ 2º"
                                    android:textColor="#FFFFFF"
                                    android:textSize="10sp"
                                    android:textStyle="bold"
                                    app:backgroundTint="#8B5CF6"
                                    app:cornerRadius="8dp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnDemanarSegons"
                                    android:layout_width="0dp"
                                    android:layout_height="38dp"
                                    android:layout_margin="2dp"
                                    android:layout_weight="1"
                                    android:insetLeft="0dp"
                                    android:insetTop="0dp"
                                    android:insetRight="0dp"
                                    android:insetBottom="0dp"
                                    android:minWidth="0dp"
                                    android:minHeight="0dp"
                                    android:padding="0dp"
                                    android:text="🔔 Segons"
                                    android:textColor="#FFFFFF"
                                    android:textSize="10sp"
                                    android:textStyle="bold"
                                    app:backgroundTint="#F59E0B"
                                    app:cornerRadius="8dp" />
                            </LinearLayout>

                            <!-- Fila 3: Compte -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnTreureCompte"
                                android:layout_width="match_parent"
                                android:layout_height="38dp"
                                android:layout_margin="2dp"
                                android:insetLeft="0dp"
                                android:insetTop="0dp"
                                android:insetRight="0dp"
                                android:insetBottom="0dp"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                android:padding="0dp"
                                android:text="🧾 Compte"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                app:backgroundTint="#0284C7"
                                app:cornerRadius="8dp" />

                            <!-- Fila 4: Cobrar -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnCobrar"
                                android:layout_width="match_parent"
                                android:layout_height="38dp"
                                android:layout_margin="2dp"
                                android:insetLeft="0dp"
                                android:insetTop="0dp"
                                android:insetRight="0dp"
                                android:insetBottom="0dp"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                android:padding="0dp"
                                android:text="€ Cobrar"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                app:backgroundTint="#10B981"
                                app:cornerRadius="8dp" />

                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>